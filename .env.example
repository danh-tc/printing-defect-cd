# Copy to .env (NOT committed). Needed for checkpoint backup to the Hugging Face Hub.
# Token: https://huggingface.co/settings/tokens  (type: Write)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Private model repo, created automatically on first push
HF_REPO=congdanh99/pdcd-checkpoints
HF_DATA_REPO=congdanh99/taktpixel2025pd-cd
# Upload interval during training (seconds)
HF_INTERVAL=600
